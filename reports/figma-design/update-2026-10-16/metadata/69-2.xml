        <frame id="103:3602" name="Line" x="15" y="59" width="312" height="18">
          <text id="103:3603" name="3" x="0" y="0" width="16" height="18" />
          <text id="103:3604" name="JOIN enrollments e" x="28" y="0" width="284" height="17" />
