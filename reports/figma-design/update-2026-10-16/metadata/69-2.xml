        <frame id="103:3605" name="Line" x="15" y="81" width="312" height="18">
          <text id="103:3606" name="4" x="0" y="0" width="16" height="18" />
          <text id="103:3607" name="ON e.student_id = s.id" x="28" y="0" width="284" height="17" />
        </frame>
        <frame id="103:3608" name="Line" x="15" y="103" width="312" height="18">
          <text id="103:3609" name="5" x="0" y="0" width="16" height="18" />
          <text id="103:3610" name="JOIN courses c" x="28" y="0" width="284" height="17" />
        </frame>
        <frame id="103:3611" name="Line" x="15" y="125" width="312" height="18">
          <text id="103:3612" name="6" x="0" y="0" width="16" height="18" />
