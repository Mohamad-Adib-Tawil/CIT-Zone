        <text id="103:3594" name="اكتب استعلام SQL يعرض اسم كل طالب مع اسم المادة المسجّل بها، مرتّباً حسب اسم الطالب." x="17" y="43" width="308" height="44" />
      </frame>
      <frame id="103:3595" name="Code editor" x="24" y="132" width="342" height="524">
        <frame id="103:3596" name="Line" x="15" y="15" width="312" height="18">
          <text id="103:3597" name="1" x="0" y="0" width="16" height="18" />
          <text id="103:3598" name="SELECT s.name, c.title" x="28" y="0" width="284" height="17" />
        </frame>
        <frame id="103:3599" name="Line" x="15" y="37" width="312" height="18">
          <text id="103:3600" name="2" x="0" y="0" width="16" height="18" />
